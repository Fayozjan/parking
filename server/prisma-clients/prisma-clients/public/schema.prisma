datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../prisma-clients/public"
}

enum NotificationSourceType {
  face_pass
  anpr_pass
}

model tenants {
  id        Int      @id @default(autoincrement())
  name      String
  subdomain String   @unique
  schema    String // имя схемы клиента
  modules   String[] @default([]) // активные модули: hr, finance, vehicle-passes

  telegram_users tenant_telegram_users[]
  door_tasks     employee_door_tasks[]
}

model employee_door_tasks {
  id          Int       @id @default(autoincrement())
  tenant_id   Int
  employee_id Int
  door_id     Int
  action      String    @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(50)
  retry_count Int       @default(0)
  error       String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)

  tenant tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([tenant_id])
}

model tenant_telegram_users {
  telegram_id String   @unique @db.VarChar(60)
  tenant_id   Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  tenant tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@id([telegram_id, tenant_id])
  @@index([telegram_id])
}

model notifications_outbox {
  id          Int                    @id @default(autoincrement())
  source_type NotificationSourceType
  event_date  DateTime               @db.Timestamptz(6)
  chat_id     String                 @db.VarChar(255)
  payload     Json
  status      String                 @default("pending") @db.VarChar(50)
  error       String?                @db.Text
  retry_count Int                    @default(0)
  created_at  DateTime               @default(now()) @db.Timestamptz(6)
  updated_at  DateTime               @updatedAt @db.Timestamptz(6)

  @@index([status, event_date])
}
